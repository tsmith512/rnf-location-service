{
  "compilerOptions": {
    "outDir": "./dist",
    "module": "esnext",
    "target": "esnext",
    "lib": ["esnext"],
    "alwaysStrict": true,
    "strict": true,
    "preserveConstEnums": true,
    "strictPropertyInitialization": false,
    "moduleResolution": "bundler",
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "@types/geojson"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "test"]
}
